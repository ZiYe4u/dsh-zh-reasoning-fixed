{
  "name": "dsh-zh-reasoning-fixed",
  "version": "1.1.1",
  "description": "DeepSeek Harness 插件：让模型的思考（reasoning）与最终回答默认使用简体中文（dsh-zh-reasoning 的非官方衍生版，修复 v4 会话 source 署名问题）。A Chinese-first plugin that makes DeepSeek Harness reason and answer in Simplified Chinese by default.",
  "license": "Apache-2.0",
  "author": "ZiYe4u (https://github.com/ZiYe4u)",
  "contributors": [
    "zhy201810576 (https://github.com/zhy201810576)",
    "imlishiyuan (https://github.com/imlishiyuan)"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chinese",
    "zh-cn",
    "reasoning",
    "i18n",
    "locale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiYe4u/dsh-zh-reasoning-fixed.git"
  },
  "homepage": "https://github.com/ZiYe4u/dsh-zh-reasoning-fixed#readme",
  "bugs": {
    "url": "https://github.com/ZiYe4u/dsh-zh-reasoning-fixed/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
